# Sylva leaderboard server — environment template.
# Copy to `.env` (which is git-ignored) and fill in real values.
#   cp .env.example .env

# --- Database ---------------------------------------------------------------
# Supabase direct connection string (Settings -> Database -> Connection string -> URI).
# If unset, the server falls back to a local SQLite file (server/playground.db)
# so development works with no credentials.
# URL-encode any of @ : / # ? & % + in the password.
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Admin dashboard (/admin) ----------------------------------------------
# Generate all three with:  python set_admin_password.py
ADMIN_KERBEROS=your_kerberos_id
ADMIN_PASSWORD_HASH=pbkdf2_sha256$...
ADMIN_SESSION_SECRET=long_random_string
